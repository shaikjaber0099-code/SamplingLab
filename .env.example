# The Sampling Lab Environment Configuration
# Optional API Keys for Cloud Model Providers (Groq & Gemini)
# If left blank, the application will automatically run in 100% offline Local GPT-2 mode.

# Groq API Key (for Llama 3.1 models): https://console.groq.com
GROQ_API_KEY=

# Google Gemini API Key: https://aistudio.google.com
GEMINI_API_KEY=
